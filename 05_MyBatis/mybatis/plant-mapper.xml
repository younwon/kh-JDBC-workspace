<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
  
  <mapper namespace="plantMapper">
  <!-- namespace : 각 mapper의 고유한 별칭 다른 매퍼랑 중복되어선 안됨 -->
  
  <insert id="save"
  		  parameterType="plant">
  		INSERT
  		  INTO
  		  	   HOUSEPLANT
  		VALUES
  			   (
  			   SEQ_PLANT_NO.NEXTVAL
  			 , #{type}
  			 , #{name}
  			   )
  </insert>
  <!-- 
  	DML
  	<insert> 쿼리문 </insert> -> <update><delete> 도 똑같음
  	pstmt객체 직접 사용할 때는 SQL문에 ?에 바인딩해야 했음
  	Mybatis를 사용할 때는 위치홀더 대슨 SQL문에 전달된 객체로부터 값을 뽑아서 사용
  	->이것이 dto객체가 필요한 이유
  	-> #{ 필드명 } => getter()를 호출해서 값을 담아줌(외자로 시작하는 변수명 금지, getter() 필수)
  	-> #{ 필드명, 변수명, map의 키값 } || ${ } => 옛날꺼(Statement)
   -->
   
   <sql id="plantColumn">
		SELECT
			   PLANT_NO AS "number"
			 , PLANT_NAME AS "name"
			 , PLANT_TYPE AS "type"
		  FROM
		 	   HOUSEPLANT
   </sql>
   
   <select id="read"
   		   resultType="plant">
		<include refid="plantColumn" />
		 ORDER
			BY		
			   PLANT_NO DESC
   </select>
   <!-- 
   		자동매핑의 조건
   		1. 기본생성자가 존재할 것 2. 별칭으로 붙이는 필드의 setter메소드가 존재할 것
   		ResultSet의 조회 컬럼명 별칭을 필드명과 동일하게 맞춰준다면 AutoMapping이 구현됨
    -->
    
    <update id="edit"
    	    parameterType="plant">
    	UPDATE
    		   HOUSEPLANT
    	   SET
    	   	   PLANT_NAME = #{name}
    	   	 , PLANT_TYPE = #{type}
    	 WHERE
    	 	   PLANT_NO = #{number}
    </update>
    
    <delete id="remove"
    	    parameterType="_int">
    	    DELETE
    	      FROM
    	    	   HOUSEPLANT
    	     WHERE
    	     	   PLANT_NO = #{plantNo}
    </delete>
    
    <select id="oneRead"
    		resultType="plant"
    	    parameterType="_int">
    		<include refid="plantColumn" />
    		 WHERE
    		 	   PLANT_NO = #{palntNo}
    </select>
    
    <select id="search"
    		resultType="plant"
    		parameterType="string">
    		<include refid="plantColumn" />
    		WHERE
    			  PLANT_TYPE LIKE '%' || #{keyword} || '%'
    		ORDER
    		   BY
    		   	  PLANT_NO DESC
    </select>
  
  </mapper>