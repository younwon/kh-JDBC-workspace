<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
  
  <mapper namespace="movieMapper">
  
  	<sql id="movieColumns">
  		SELECT
  			   MOVIE_ID
  			 , MOVIE_NAME
  			 , RELEASE_DATE
  			 , RUNNING_TIME
  			 , MOVIE_RATING
  		  FROM
  		  	   MOVIE
  	</sql>
  	
  	<resultMap type="movieDto" id="movieAndReviews">
  		<id column="MOVIE_ID" property="movieId"/>
  		<result column="MOVIE_NAME" property="movieName"/>
  		<result column="RELEASE_DATE" property="reseaseDate"/>
  		<result column="RUNNING_TIME" property="runningTime"/>
  		<result column="MOVIE_RATING" property="movieRating"/>
  		<collection property="reviews" ofType="movieReviewDto">
  			<id column="REVIEW_NO" property="reviewNo"/>
  			<result column="CONTENT" property="content"/>
  			<result column="REVIEW_DATE" property="reviewDate"/>
  			<result column="RATING" property="rating"/>
  		</collection>
  	</resultMap>
  	
  	<select id="selectAll"
  			resultType="movieDto">
  			
  		<include refid="movieColumns" />
  		 ORDER
  		 	BY
  		 	   MOVIE_ID DESC
  	</select>
  	
  	<select id="selectMoviewAndReviews"
  			resultMap="movieAndReviews">
  		SELECT
  			   m.MOVIE_ID
  			 , MOVIE_NAME
  			 , REVIEW_NO
  			 , CONTENT
  			 , REVIEW_DATE
  			 , RATING
  		  FROM
  		  	   MOVIE m
  		  LEFT
  		  JOIN
  		  	   MOVIE_REVIEW r
  		    ON
  		       m.MOVIE_ID = r.MOVIE_ID 	
  		 ORDER
  		 	BY
  		 	   r.REVIEW_DATE DESC	  	
  	</select>
  	
  	<select id="searchByCondition"
  			resultMap="movieAndReviews"
  			parameterType="map">
  		SELECT
  			   m.MOVIE_ID
  			 , MOVIE_NAME
  			 , MOVIE_RATING
  			 , REVIEW_NO
  			 , CONTENT
  			 , RATING
  		  FROM
  		  	   MOVIE m
  		  LEFT
  		  JOIN
  		  	   MOVIE_REVIEW r
  		 USING
  		 	   (MOVIE_ID)
  		 WHERE
  		 	   <choose>
  		 	   	<when test="menuNo == 1">
  		 	   		MOVIE_NAME LIKE '%' || #{keyword} || '%'
  		 	   	</when>
  		 	   	<when test="menuNo == 2">
  		 	   		MOVIE_RATING LIKE '%' || #{keyword} || '%'
  		 	   	</when>
  		 	   	<when test="menuNo == 3">
  		 	   		COTENT LIKE '%' || #{keyword} || '%'
  		 	   	</when>
  		 	   	<otherwise>
  		 	   		1=1
  		 	   	</otherwise>
  		 	   </choose>
  		 ORDER
  		 	BY
  		 	   MOVIE_ID DESC
  	</select>
  	
  	<select id="selectOne"
  			parameterType="_int"
  			resultType="MovieDto">
  			
  		<include refid="movieColumns" />
  		 WHERE
  		 	   MOVIE_ID = #{movieId}
  		 ORDER
  		 	BY
  		 	   MOVIE_ID DESC
  	</select>
  	
  	<insert id="insertMovie"
  			parameterType="movieDto">
  		INSERT
  		  INTO
  		  	   MOVIE
  		VALUEC
  			   (
  			   SEQ_MOVIE_ID.NEXTVAL
  			 , MOVIE_NAME
  			 , RELEASE_DATE
  			 , RUNNING_TIME
  			 , MOVIE_RATING
  			   )
  	</insert>
  	
  	<update id="updateTime"
  			parameterType="MovieDto">
  		UPDATE
  			   MOVIE
  		   SET
  		   	   RUNNING_TIME = ${runningTime}
  		 WHERE
  		 	   MOVIE_ID = ${movieId}
  	</update>
  	
  	<delete id="deleteMovie"
  			parameterType="_long">
  		DELETE
  		  FROM
  		  	   MOVIE
  		 WHERE
  		 	   MOVIE_ID = ${MOVIE_ID}
  	</delete>
  	
  </mapper>