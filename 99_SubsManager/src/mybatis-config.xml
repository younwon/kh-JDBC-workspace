<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE configuration
PUBLIC "-//mybatis.org//DTD Config 3.0//EN"
"https://mybatis.org/dtd/mybatis-3-config.dtd">

<configuration>
	<settings>
		<!-- 실행되는 SQL을 콘솔에 찍어줌 => 디버깅용, 끄지 말 것!! -->
		<setting name="logImpl" value="STDOUT_LOGGING"/>
		<!-- SUB_NAME 컬럼을 subName 필드에 자동으로 넣어줌 -->
		<setting name="mapUnderscoreToCamelCase" value="true"/>
	</settings>
	
	<typeAliases>
		<!-- 매퍼에서 긴 클래스 풀네임 대신 짧은 별칭 쓰려고 -->
		<typeAlias type="com.kh.subs.model.dto.SubscriptionDto" alias="sub"/>
	</typeAliases>
	
	<environments default="development">
		<environment id="development">
			<transactionManager type="MANAGED" />
			<dataSource type="UNPOOLED">
				<property name="driver" value="oracle.jdbc.driver.OracleDriver"/>
				<property name="url" value="jdbc:oracle:thin:@127.0.0.1:1521/XEPDB1"/>
				<property name="username" value="HOSPITAL"/>
				<property name="password" value="oracle"/>
			</dataSource>
		</environment>
	</environments>
	
	<mappers>
		<mapper resource="subs-mapper.xml" />
	</mappers>
</configuration>