<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
  
  <mapper namespace="movieMapper">
  	
  	<select id="selectAll"
  			resultType="movie">
  		SELECT
  			   MOVIE_ID
  			 , MOVIE_NAME
  			 , RELEASE_DATE
  			 , RUNNING_TIME
  			 , MOVIE_RATING
  		  FROM
  		  	   MOVIE
  		 ORDER
  		 	BY
  		 	   MOVIE_ID DESC
  	</select>
  	
  </mapper>